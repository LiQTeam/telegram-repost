# ============================================================
#  MR LiQ Telegram Repost Bot — نمونه‌ی فایل تنظیمات
#  این فایل را به .env کپی کن و مقادیر را پر کن:
#      cp .env.example .env
#  (اسکریپت install.sh این فایل را به‌صورت خودکار می‌سازد.)
# ============================================================

# ---------------- هسته‌ی ربات (ضروری) ----------------
# توکن ربات از @BotFather
BOT_TOKEN=
# آیدی عددیِ ادمین‌ها (از @userinfobot)، در صورت چند نفر با کاما جدا کن
ADMIN_IDS=
# آیدی عددیِ کانال مقصدِ پیش‌فرض (اختیاری؛ می‌توانی از داخل ربات هم اضافه کنی)
TARGET_CHAT_ID=

# ---------------- دیتابیس و زمان ----------------
DB_PATH=data/bot.sqlite
# منطقه‌ی زمانی؛ ساعت‌های زمان‌بندی بر همین اساس حساب می‌شوند
TIMEZONE=Asia/Tehran

# ---------------- همزمانی و کش ----------------
# حداکثر تعداد عکسِ هم‌زمانِ در حال پردازش (واترمارک/AI)
MAX_CONCURRENT_HEAVY_JOBS=3
# سقفِ تعداد آیتم در کشِ دانلود
DOWNLOAD_CACHE_MAX_ITEMS=200
# مدتِ نگه‌داریِ هر آیتم در کش (ثانیه)
DOWNLOAD_CACHE_TTL_SECONDS=1800
# سقفِ کلِ کشِ دانلود (بایت) — پیش‌فرض ۱۵۰ مگابایت
DOWNLOAD_CACHE_MAX_BYTES=157286400
# سقفِ حجمِ هر فایلِ دانلودی (بایت) — پیش‌فرض ۶۰ مگابایت
MAX_DOWNLOAD_BYTES=62914560
# کشِ نتیجه‌ی داوریِ AI برای فیلترِ تبلیغات
AD_FILTER_CACHE_MAX_ITEMS=2000
AD_FILTER_CACHE_TTL_SECONDS=21600

# ---------------- تشخیص واترمارک ----------------
TEMPLATE_MATCH_THRESHOLD=0.75
MAX_WATERMARK_AREA_RATIO=0.3

# ---------------- کلیدهای AI (اختیاری) ----------------
# اگر خالی باشند، ماژول‌های AI به‌صورتِ graceful غیرفعال می‌شوند
MISTRAL_API_KEY=
GROQ_API_KEY=

# پروکسی فقط برای Gemini (generativelanguage.googleapis.com از رنجِ آی‌پیِ خیلی
# از کشورها با HTTP 403 بلاک می‌شود؛ Mistral/Groq/HuggingFace نیازی ندارند).
# خالی = بدونِ پروکسی. فرمت: socks5://host:port یا http://host:port
# (با یوزر/پس: socks5://user:pass@host:port). برای socks5 پکیجِ socksio لازم
# است که در requirements.txt هست.
GEMINI_PROXY_URL=

# نکته: کلیدهای «مدیریتِ API هوش مصنوعی» (Providerهای سفارشی) و کلیدهای
# SerpAPIِ «جست‌وجویِ وب» از داخلِ منوی خودِ ربات وارد و رمزنگاری‌شده در
# دیتابیس ذخیره می‌شوند — در این فایل چیزی برایشان لازم نیست.

# ---------------- تولید تصویر با AI (اختیاری) ----------------
# ترتیب اولویت: Pollinations -> DeepAI -> Stable Horde
POLLINATIONS_API_KEY=
DEEPAI_API_KEY=
STABLEHORDE_API_KEY=
IMAGE_GEN_TIMEOUT=30
IMAGE_GEN_MAX_RETRIES=2
STABLEHORDE_POLL_TIMEOUT=180
STABLEHORDE_POLL_INTERVAL=5

# ---------------- API اکستنشنِ مرورگر (اختیاری) ----------------
# فقط پشتِ فایروال/شبکه‌ی قابل‌اعتماد فعال کن (توکن به‌صورت متن ساده رد و بدل می‌شود)
EXTENSION_API_ENABLED=false
EXTENSION_API_HOST=0.0.0.0
EXTENSION_API_PORT=8843
EXTENSION_API_TOKEN=
